{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "..",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["run.ts", "../src/core/**/*.ts"]
}
